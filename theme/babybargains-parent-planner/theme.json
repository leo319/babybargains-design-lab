{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "navy", "name": "Navy", "color": "#0B3A5B" },
				{ "slug": "navy-dark", "name": "Navy (dark)", "color": "#072A42" },
				{ "slug": "sky", "name": "Sky", "color": "#0EA5E9" },
				{ "slug": "sky-medium", "name": "Sky (medium)", "color": "#0284C7" },
				{ "slug": "sky-dark", "name": "Sky (dark, text)", "color": "#0369A1" },
				{ "slug": "sky-soft", "name": "Sky (soft)", "color": "#BAE6FD" },
				{ "slug": "sky-light", "name": "Sky (light)", "color": "#E0F2FE" },
				{ "slug": "base", "name": "Background", "color": "#F8FAFC" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "contrast", "name": "Ink", "color": "#0F172A" },
				{ "slug": "slate", "name": "Slate", "color": "#475569" },
				{ "slug": "muted", "name": "Muted", "color": "#64748B" },
				{ "slug": "border", "name": "Border", "color": "#E2E8F0" },
				{ "slug": "save", "name": "Savings green", "color": "#047857" },
				{ "slug": "save-bg", "name": "Savings green (tint)", "color": "#ECFDF5" }
			],
			"gradients": [
				{ "slug": "sky-wash", "name": "Sky wash", "gradient": "linear-gradient(120deg,#E0F2FE 0%,#F0F9FF 60%,#FFFFFF 100%)" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1144px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "sm", "name": "Small", "shadow": "0 1px 2px rgba(15,23,42,.04), 0 1px 3px rgba(15,23,42,.05)" },
				{ "slug": "md", "name": "Medium", "shadow": "0 10px 30px -12px rgba(11,58,91,.22)" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "em", "%", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "8px" },
				{ "slug": "20", "name": "S", "size": "14px" },
				{ "slug": "30", "name": "M", "size": "22px" },
				{ "slug": "40", "name": "L", "size": "28px" },
				{ "slug": "50", "name": "XL", "size": "clamp(32px, 5vw, 44px)" },
				{ "slug": "60", "name": "2XL", "size": "clamp(56px, 7vw, 72px)" },
				{ "slug": "70", "name": "3XL", "size": "clamp(64px, 8vw, 88px)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Source Sans 3",
					"fontFamily": "\"Source Sans 3\", system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Source Sans 3", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/source-sans-3-latin.woff2" ] },
						{ "fontFamily": "Source Sans 3", "fontStyle": "italic", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/source-sans-3-italic-latin.woff2" ] }
					]
				},
				{
					"slug": "serif",
					"name": "Fraunces",
					"fontFamily": "Fraunces, Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-latin.woff2" ] },
						{ "fontFamily": "Fraunces", "fontStyle": "italic", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-italic-latin.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "XS", "size": "13px" },
				{ "slug": "small", "name": "S", "size": "15px" },
				{ "slug": "medium", "name": "M", "size": "17px" },
				{ "slug": "large", "name": "L", "size": "20px" },
				{ "slug": "x-large", "name": "XL", "size": "25px" },
				{ "slug": "xx-large", "name": "2XL", "size": "clamp(28px, 3.2vw, 38px)" },
				{ "slug": "display", "name": "Display", "size": "clamp(44px, 6vw, 76px)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "24px",
			"padding": {
				"left": "clamp(18px, 4vw, 28px)",
				"right": "clamp(18px, 4vw, 28px)",
				"top": "0",
				"bottom": "0"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"color": { "text": "var:preset|color|navy" },
				"typography": {
					"fontFamily": "var:preset|font-family|serif",
					"fontWeight": "600",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": { "typography": { "fontSize": "clamp(36px, 4.6vw, 56px)", "lineHeight": "1.06" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|xx-large", "lineHeight": "1.12" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|x-large", "lineHeight": "1.2", "letterSpacing": "-0.01em" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|large", "letterSpacing": "-0.01em" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"h6": { "typography": { "fontSize": "var:preset|font-size|small" } },
			"link": {
				"color": { "text": "var:preset|color|sky-dark" },
				"typography": { "textDecoration": "none" },
				":hover": { "typography": { "textDecoration": "underline" } },
				":focus-visible": { "outline": { "color": "var:preset|color|sky", "style": "solid", "width": "3px", "offset": "2px" } }
			},
			"button": {
				"color": {
					"background": "var:preset|color|sky",
					"text": "var:preset|color|white"
				},
				"border": { "radius": "12px", "width": "0", "style": "none" },
				"spacing": { "padding": { "top": "14px", "bottom": "14px", "left": "26px", "right": "26px" } },
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "16.5px",
					"fontWeight": "700",
					"lineHeight": "1.4"
				},
				":hover": { "color": { "background": "var:preset|color|sky-medium", "text": "var:preset|color|white" } },
				":focus": { "color": { "background": "var:preset|color|sky-medium", "text": "var:preset|color|white" } },
				":focus-visible": { "outline": { "color": "var:preset|color|navy", "style": "solid", "width": "3px", "offset": "2px" } }
			},
			"caption": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "15.5px", "fontWeight": "600" },
				"color": { "text": "var:preset|color|navy" }
			},
			"core/post-title": {
				"elements": { "link": { "color": { "text": "var:preset|color|navy" } } }
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|small", "fontWeight": "600" }
			},
			"core/post-excerpt": {
				"color": { "text": "var:preset|color|slate" },
				"typography": { "fontSize": "16px" }
			},
			"core/quote": {
				"border": { "color": "var:preset|color|sky", "style": "solid", "width": "0 0 0 3px" },
				"spacing": { "padding": { "left": "22px" } },
				"typography": { "fontFamily": "var:preset|font-family|serif", "fontSize": "var:preset|font-size|large", "fontStyle": "italic" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|border" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Page (wide, no title)", "postTypes": [ "page" ] }
	]
}
